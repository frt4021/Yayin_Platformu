name: "whisper"
backend: "python"
max_batch_size: 8

input [
  { name: "PCM_AUDIO", data_type: TYPE_INT16, dims: [ -1 ] }
]
output [
  { name: "PIVOT_TEXT", data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "SOURCE_LANGUAGE", data_type: TYPE_STRING, dims: [ 1 ] },
  { name: "LANGUAGE_CONFIDENCE", data_type: TYPE_FP32, dims: [ 1 ] }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  # STT_BATCH_WINDOW_MS=80 ile ayni, olculmus deger (docs/batching-boyut-olcumu.md):
  # ort. batch 2.27, 1.97x hizlanma. Sifirdan tahmin degil, mevcut BatchCoalescer'in
  # zaten dogrulanmis penceresi.
  max_queue_delay_microseconds: 80000
}

# sequence_batching KASITLI YOK: stt.py'deki transcribe_batch her segmenti
# BAGIMSIZ isliyor (kesitler arasi context/state yok, VAD zaten Java'da
# tam cumleyi bitirip gonderiyor). Tasinacak state olmadigi icin CORRID/
# oturum takibi gereksiz karmasiklik olurdu.

instance_group [
  { count: ${WHISPER_INSTANCES}, kind: KIND_GPU, gpus: [ 0 ] }
  # ${WHISPER_INSTANCES}, entrypoint.sh'de envsubst ile .env'deki
  # WHISPER_INSTANCES degerine gore doldurulur -- container YENIDEN
  # BASLATILINCA (rebuild GEREKMEZ) degisir. count=2 gercek ikinci bir VRAM
  # kopyasi acar (bugunku STT_MAX_CONCURRENCY'nin TEK kopyayi
  # paylastirmasindan farkli) -- VRAM tepe degeri ayrica olculmeli.
]
