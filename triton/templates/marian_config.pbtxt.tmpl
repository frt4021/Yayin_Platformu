name: "__MODEL_NAME__"
backend: "python"
max_batch_size: 16

input [
  { name: "SOURCE_TEXT", data_type: TYPE_STRING, dims: [ 1 ] }
]
output [
  { name: "TRANSLATED_TEXT", data_type: TYPE_STRING, dims: [ 1 ] }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 50000
}

instance_group [
  # ${MARIAN_INSTANCE_COUNT} BILEREK dolu birakildi -- export_models.py bu
  # sablonu build zamaninda her dil icin __MODEL_NAME__'i doldurup kopyalar,
  # ama instance sayisi CALISMA ZAMANINDA (entrypoint.sh, MARIAN_INSTANCES/
  # MARIAN_INSTANCES_DEFAULT'tan) belirleniyor -- rebuild gerekmeden
  # `docker compose up -d triton` ile degisebilsin diye (bkz. WHISPER_INSTANCES
  # ile ayni desen, triton/entrypoint.sh).
  { count: ${MARIAN_INSTANCE_COUNT}, kind: KIND_GPU, gpus: [ 0 ] }
]

response_cache {
  enable: true
  # Haber kanallarindaki tekrarlayan anons/kalip cumleler (jingle, "haberlerin
  # devaminda..." gibi) icin gercek hit potansiyeli var -- whisper'da
  # AYNI ayar yok cunku ses byte'lari neredeyse hic birebir ayni olmuyor.
}
