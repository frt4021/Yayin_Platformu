# Yayın Merkezi — örnek yapılandırma.
#
# BU DOSYAYI KOPYALAMANIZA GEREK YOK. `./baslat.sh` çalıştırıldığında .env
# yoksa kendiliğinden üretilir; makinenin LAN adresi ve GPU'su otomatik
# bulunur. Bu dosya yalnızca hangi alanların var olduğunu göstermek için.
#
# Alanların ne işe yaradığı ve nasıl doldurulacağı: README → ".env alanları"

QUARKUS_PROFILE=prod

# --- Veritabanı ---
# Üretimde MUTLAKA değiştirin. İlk açılışta oluşturulur; sonradan değiştirmek
# için ./baslat.sh --sifirla gerekir.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=degistirin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=degistirin

# --- Keycloak ---
# DİKKAT: KEYCLOAK_CLIENT_SECRET, realm-export.json içindekiyle AYNI olmak
# zorunda. Farklı olursa giriş sessizce başarısız olur.
KEYCLOAK_CLIENT_SECRET=12345678
KEYCLOAK_CLIENT_ID=Yayın_App
KEYCLOAK_REALM=YayinYonetimi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BOOTSTRAP_PASSWORD=12345678

# --- Nesne depolama ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=degistirin

# --- TARAYICIDA açılan adresler ---
# EN SIK HATA KAYNAĞI. "localhost" yazılırsa ağdaki başka bir cihaz onu KENDİ
# makinesi sanar; ne yayın ne indirme çalışır. Makinenin LAN IP'sini yazın.
MINIO_PUBLIC_URL=http://192.168.1.20:9000
MEDIAMTX_HLS_BASE_URL=http://192.168.1.20:8888
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.20:3000

# --- Donanım kodlayıcı ---
# NVENC (NVIDIA) | VAAPI (Intel/AMD) | YAZILIM (libx264, CPU)
#
# NVIDIA için:
#   CHANNELS_ENCODER=NVENC
#   VIDEOS_ENCODER=NVENC
#   CONTAINER_RUNTIME=nvidia
#   NVIDIA_VISIBLE_DEVICES=all
#   NVIDIA_DRIVER_CAPABILITIES=video,compute,utility
#   MEDIA_DEVICE=/dev/null:/dev/null
CHANNELS_ENCODER=VAAPI
VIDEOS_ENCODER=YAZILIM
CONTAINER_RUNTIME=runc
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=
MEDIA_DEVICE=/dev/dri:/dev/dri
WORKER_MEDIA_DEVICE=/dev/null:/dev/null

# --- Depolama: saklama ve temizlik politikasi ---
# Sureler GUN ya da SAAT olarak yazilabilir:
#   P30D = 30 gun · 720h = ayni sure · PT12H = 12 saat · 0 = KAPALI
#
# Varsayilan olarak KULLANICI VERISI SILINMIYOR: klip, kayit ve ekran
# goruntusu kullanicinin arsivi. Baskiyi kota kursun, saat degil.
STORAGE_CLIP_RETENTION=0
STORAGE_SCREENSHOT_RETENTION=0
# Basarisiz klipler varsayilan olarak siliniyor: dosyalari zaten yok.
STORAGE_FAILED_CLIP_RETENTION=P7D
STORAGE_SWEEP_INTERVAL=1h

# Kullanici basina kota: klip + kayit + ekran goruntusu + video toplami.
# Kota dolunca YENI IS reddedilir, var olan SILINMEZ. 0 = sinirsiz.
STORAGE_USER_QUOTA_BYTES=21474836480

# --- Ekran goruntuleri ---
SCREENSHOTS_BUCKET=ekran-goruntuleri
SCREENSHOTS_URL_TTL_HOURS=6
SCREENSHOTS_MAX_BYTES=10485760

# --- Yol ---
# DVR kayıtları. Üretimde büyük diski gösterin:
# 16 kanal × 7 gün × 6 Mbps ≈ 7,3 TB
# DVR_PATH=/mnt/dvr
