{
  "title": "Servis Durumu",
  "uid": "servis-durumu",
  "description": "Prometheus'un taradığı her hedefin scrape-seviyesinde durumu (up=1/down=0). Admin panelin 'Genel Bakış' sayfasındaki uygulama-seviyesi sağlık kontrollerinden farklı — bu, Prometheus'un hedefe hiç ulaşıp ulaşamadığını gösterir.",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    { "id": 1, "title": "backend", "type": "stat", "datasource": "Prometheus", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"backend\"}", "legendFormat": "backend" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
        { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
      ], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } } },
