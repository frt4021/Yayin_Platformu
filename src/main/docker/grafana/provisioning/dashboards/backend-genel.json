{
  "title": "Backend & Video-Worker Genel",
  "uid": "backend-genel",
  "description": "backend ve video-worker aynı jar (Quarkus + Micrometer); job etiketiyle ayrılıyor. Uygulamaya özel metrikler (altyazı kuyruğu, oynatma hatası) ayrı dashboard'larda — burası jenerik HTTP/JVM/DB-havuzu sağlığı.",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "HTTP istek oranı (durum koduna göre)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"backend|video-worker\"}[5m]))", "legendFormat": "{{job}} — {{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 gecikme",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket{job=~\"backend|video-worker\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "JVM heap kullanımı",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"backend|video-worker\", area=\"heap\"})", "legendFormat": "{{job}} kullanılan" },
        { "expr": "sum by (job) (jvm_memory_max_bytes{job=~\"backend|video-worker\", area=\"heap\"})", "legendFormat": "{{job}} azami" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "GC duraklama süresi (oran)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (job) (rate(jvm_gc_pause_seconds_sum{job=~\"backend|video-worker\"}[5m]))", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Canlı thread sayısı",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=~\"backend|video-worker\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 6,
      "title": "Agroal DB bağlantı havuzu (aktif/boşta)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "agroal_active_count{job=~\"backend|video-worker\"}", "legendFormat": "{{job}} aktif" },
        { "expr": "agroal_available_count{job=~\"backend|video-worker\"}", "legendFormat": "{{job}} boşta" }
      ]
    }
  ]
}
